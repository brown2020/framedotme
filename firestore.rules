rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function noPrivEscalationOnUserDoc() {
      // Client may not set privileged flags. Absent fields are fine.
      return (!("isAdmin" in request.resource.data) || request.resource.data.isAdmin == false)
        && (!("isAllowed" in request.resource.data) || request.resource.data.isAllowed == false)
        && (!("isInvited" in request.resource.data) || request.resource.data.isInvited == false)
        && (!("premium" in request.resource.data) || request.resource.data.premium == false);
    }

    // Updates cannot clear or set privilege flags. Admin SDK writes bypass rules.
    function privilegesUnchanged() {
      return request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false)
        && request.resource.data.get('isAllowed', false) == resource.data.get('isAllowed', false)
        && request.resource.data.get('isInvited', false) == resource.data.get('isInvited', false)
        && request.resource.data.get('premium', false) == resource.data.get('premium', false);
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // User-owned namespace
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && noPrivEscalationOnUserDoc();
      allow update: if isOwner(userId) && noPrivEscalationOnUserDoc() && privilegesUnchanged();
      // Account deletion is performed with the Admin SDK.
      allow delete: if false;

      match /profile/userData {
        allow read: if isOwner(userId);
        // Starter balance only. Later credit changes are Admin SDK only.
        allow create: if isOwner(userId)
          && request.resource.data.credits == 1000;
        allow update: if isOwner(userId)
          && request.resource.data.credits == resource.data.credits;
        allow delete: if false;
      }

      match /settings/recorder {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /botcasts/{botcastId} {
        allow read: if isOwner(userId);
        // Metadata is written by the server after a credit charge.
        allow create, update: if false;
        allow delete: if isOwner(userId);
      }

      match /payments/{paymentDocId} {
        allow read: if isOwner(userId);
        // Immutable. Created by the Admin SDK after Stripe verification.
        allow create, update, delete: if false;
      }

      match /uploadGrants/{grantId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if false;
      }

      match /security/{docId} {
        allow read, write: if false;
      }
    }
  }
}
