rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function uploadGrant(userId, filename) {
      return /databases/(default)/documents/users/$(userId)/uploadGrants/$(filename);
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // User recordings. `get` does not include list.
    match /{userId}/botcasts/{filename} {
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId)
        && filename.matches('.*\\.webm')
        && request.resource.size < 500 * 1024 * 1024
        && request.resource.contentType.matches('video/webm.*')
        && firestore.exists(uploadGrant(userId, filename))
        && firestore.get(uploadGrant(userId, filename)).data.used == false;

      allow update: if false;
      allow delete: if isOwner(userId);
    }
  }
}
